[Unit]
Description=Phone Shop Spring Boot backend
After=network-online.target mysql.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=simple
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ phone_shop_dir }}/phoneshop-backend
EnvironmentFile=/etc/phone-shop/backend.env
ExecStart=/usr/bin/java -jar {{ backend_jar }}
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
